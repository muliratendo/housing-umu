{
  "compilerOptions": {
      "types": ["ziggy-js"],
      "target": "esnext",
      "module": "esnext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "lib": ["dom", "dom.iterable", "esnext"],
      "skipLibCheck": true,
      "paths": {
          "@/*": ["./resources/js/*"] // 🚀 FIXED: Added leading ./ and dropped baseUrl entirely
      }
  },
  "include": ["resources/js/**/*", "resources/js/**/*.tsx", "resources/js/**/*.ts"]
}
